# ====================================================================
# VIETAI LIFE — ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# 1. DeepSeek Live AI API Key (Khuyến nghị cho chất lượng tối ưu)
# Lấy API Key tại: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 2. Google Gemini API Key (Tùy chọn)
# Lấy miễn phí tại: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Backend API Gateway URL (Tùy chọn khi chạy full microservices)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
