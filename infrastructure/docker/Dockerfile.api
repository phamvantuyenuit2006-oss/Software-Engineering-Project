# Dockerfile for Backend API
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

COPY services/api/ ./services/api/
RUN dotnet restore services/api/src/API/VietAILife.API.csproj
RUN dotnet publish services/api/src/API/VietAILife.API.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /out ./
EXPOSE 8080
ENTRYPOINT ["dotnet", "VietAILife.API.dll"]
